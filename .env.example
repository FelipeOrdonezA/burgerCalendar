# Local development defaults to JSON files and needs no credentials.
# Optional process environment variables:
# STORAGE_DRIVER=local
# DATA_DIR=C:/path/to/test-data

# Manual import only: copy this file to .env.local in the repository root.
# The import command loads .env.local. Never commit a real token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel Production/Preview: configure STORAGE_DRIVER=blob in project settings.
# Connect a PRIVATE Blob store to each environment (separate stores).
# Vercel supplies BLOB_STORE_ID / VERCEL_OIDC_TOKEN, or BLOB_READ_WRITE_TOKEN.
