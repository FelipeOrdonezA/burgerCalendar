  "bugs": {
    "url": "https://github.com/FelipeOrdonezA/burgerCalendar/issues"
  },
  "homepage": "https://github.com/FelipeOrdonezA/burgerCalendar#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "serve": "^14.2.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": "24.x"
  }
