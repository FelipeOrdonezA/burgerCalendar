{
  "name": "burgercalendar",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "frontend": "serve frontend -l 5173",
    "dev": "npm --prefix backend run dev",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run frontend\"",
    "build": "npm --prefix backend run build && node scripts/build-frontend.cjs",
    "test": "npm run test:services && npm run test:storage",
    "test:services": "npm --prefix backend run test:services",
    "test:storage": "npm --prefix backend run test:storage",
    "data:import:blob": "npm --prefix backend run data:import:blob --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelipeOrdonezA/burgerCalendar.git"
  },
